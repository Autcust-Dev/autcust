---
import SEO from '../../../components/SEO.astro';
import InstallGuides from '../../../components/torrentxdesk/InstallGuides.astro';
import '../../../styles/global.css';
import { getLatestRelease, sitePath, formatSize, type Release, type ReleaseFile } from '../../../lib/torrentxdesk';

export const prerender = false;

const SITE = 'https://autcust.com';
const PAGE_URL = `${SITE}/download/torrentxdesk`;
const OG_IMAGE = '/og/torrentxdesk.png';
const PLAY_STORE_URL = 'https://play.google.com/store/apps/details?id=com.torrentx';

let release: Release | null = null;
try {
	release = await getLatestRelease();
} catch (e) {
	console.error('TorrentXDesk download page error:', e instanceof Error ? e.message : e);
}

const files = release?.files ?? [];
const byId = (id: ReleaseFile['id']) => files.find((f) => f.id === id);
const exe = byId('exe');
const deb = byId('deb');
const rpm = byId('rpm');
const winFiles = files.filter((f) => f.platform === 'windows');
const linuxFiles = files.filter((f) => f.platform === 'linux');

const blurb: Record<ReleaseFile['id'], string> = {
	exe: 'Recommended for most people',
	msi: 'For IT admins and managed installs',
	deb: 'Ubuntu 24.04+, Debian 13+, Linux Mint 22+, Pop!_OS 24.04+',
	rpm: 'Fedora, openSUSE',
	tar: 'Any 64-bit Linux distro, no installation needed',
};
const shortSha = (s?: string) => (s ? `${s.slice(0, 10)}…${s.slice(-6)}` : null);
const releasedOn = release?.publishedAt
	? new Date(release.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
	: null;

const features = [
	{ title: 'Magnet links & .torrent files', text: 'Paste a magnet link or open a .torrent file and start downloading in seconds.', icon: '<path d="M6 15V9a6 6 0 0 1 12 0v6"/><path d="M6 15h4v-6"/><path d="M14 9v6h4"/><path d="M6 19h4M14 19h4"/>' },
	{ title: 'Pick what you need', text: 'Choose exactly which files to download from a torrent and skip the rest.', icon: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>' },
	{ title: 'Stream while downloading', text: 'Start watching or listening before the download has finished.', icon: '<circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/>' },
	{ title: 'Light & dark themes', text: 'A clean interface that matches the way you like your desktop.', icon: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>' },
	{ title: 'Runs in the system tray', text: 'Keeps downloading quietly in the background while you get on with your day.', icon: '<rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 21h8M12 18v3"/><circle cx="17" cy="14" r="1"/>' },
	{ title: 'Windows & Linux', text: 'Installers for Windows, plus .deb, .rpm and portable builds for Linux.', icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>' },
];

// Visible FAQ — the same text is used for FAQPage structured data.
const faqs = [
	{ q: 'Is TorrentXDesk free?', a: 'Yes. TorrentXDesk is free to download and use on Windows and Linux.' },
	{ q: 'Which download should I choose?', a: 'On Windows, use the .exe installer (the .msi is for IT admins). On Ubuntu, Debian, Linux Mint or Pop!_OS, use the .deb package. On Fedora or openSUSE, use the .rpm package. On any other Linux distribution, or an older Ubuntu or Debian release, use the portable .tar.gz archive.' },
	{ q: 'Why does Windows say "Windows protected your PC"?', a: 'The TorrentXDesk installer is not digitally signed yet, so Windows SmartScreen does not recognise it. Click "More info" and then "Run anyway" to continue. The signed version will arrive with the Microsoft Store release.' },
	{ q: 'Which Linux distributions are supported?', a: 'The .deb package works on Ubuntu 24.04 or newer, Debian 13 or newer, Linux Mint 22 or newer and Pop!_OS 24.04 or newer. The .rpm package is for Fedora and openSUSE. The portable .tar.gz runs on other 64-bit (x86_64) Linux distributions.' },
	{ q: 'Is TorrentXDesk available on the Microsoft Store?', a: 'Not yet. The official release of TorrentXDesk is coming soon to the Microsoft Store. Until then, you can download the latest version from this page.' },
	{ q: 'How do I update TorrentXDesk?', a: 'On Windows, TorrentXDesk updates automatically. On Linux, download the latest package from this page and install it the same way as before.' },
	{ q: 'Is there a mobile version?', a: 'TorrentXDesk is for desktop computers. On Android phones and tablets, use TorrentX, available on Google Play.' },
];

const title = 'TorrentXDesk: Free Torrent Client for Windows & Linux';
const description =
	'Download TorrentXDesk, a free, fast torrent client for Windows and Linux. Magnet links, file selection and streaming while downloading. .exe, .deb and .rpm.';

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'TorrentXDesk',
		description,
		url: PAGE_URL,
		image: `${SITE}${OG_IMAGE}`,
		applicationCategory: 'UtilitiesApplication',
		applicationSubCategory: 'BitTorrent client',
		operatingSystem: 'Windows, Linux',
		...(release && { softwareVersion: release.version }),
		...(release?.publishedAt && { datePublished: release.publishedAt.slice(0, 10) }),
		...(release?.notes && { releaseNotes: release.notes }),
		...(exe?.size && { fileSize: formatSize(exe.size) }),
		...(files.length && { downloadUrl: files.map((f) => `${SITE}${sitePath(f.name)}`) }),
		featureList: features.map((f) => f.title),
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		publisher: { '@type': 'Organization', name: 'Autcust', url: SITE, logo: `${SITE}/logo.png` },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Autcust', item: `${SITE}/` },
			{ '@type': 'ListItem', position: 2, name: 'Download TorrentXDesk', item: PAGE_URL },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
	},
];
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c');

const downloadIcon = '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/>';

Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<html lang="en">
	<head>
		<SEO
			title={title}
			description={description}
			canonicalUrl={PAGE_URL}
			image={OG_IMAGE}
			imageAlt="TorrentXDesk: free torrent client for Windows and Linux"
			imageWidth={1200}
			imageHeight={630}
		/>
		<meta name="theme-color" content="#000000" />
		<meta name="keywords" content="TorrentXDesk, torrent client, BitTorrent client, Windows torrent client, Linux torrent client, magnet links, download torrents, Autcust" />
		<script is:inline type="application/ld+json" set:html={jsonLdHtml} />
		<style is:global>
			body {
				background:
					radial-gradient(1200px 600px at 50% -10%, rgba(244, 240, 230, 0.09), transparent 60%),
					radial-gradient(800px 400px at 100% 40%, rgba(244, 240, 230, 0.04), transparent 70%),
					#000;
				background-attachment: fixed;
			}
			html { scroll-behavior: smooth; }
			.page { max-width: 1120px; margin: 0 auto; padding: 0 24px 4rem; }
			.mono { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
			.os-icon { display: inline-block; width: 1.1em; height: 1.1em; flex-shrink: 0; }
			:is(.cta, .btn-dl, .btn-ghost, .tab, .copy, .dialog-close, .nav-cta, .toast-btn, .toast-close, summary):focus-visible {
				outline: 2px solid #fff; outline-offset: 3px;
			}

			/* ---------- Top navigation ---------- */
			.nav {
				position: sticky; top: 0; z-index: 20; margin: 0 -24px; padding: 0.85rem 24px;
				display: flex; align-items: center; justify-content: space-between; gap: 1rem;
				background: rgba(0, 0, 0, 0.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
				border-bottom: 1px solid rgba(244, 240, 230, 0.08);
			}
			.nav-brand { display: flex; align-items: center; gap: 0.6rem; color: #fff; font-weight: 600; }
			.nav-brand:hover { color: #fff; }
			.nav-brand .crumb { color: var(--text-muted); font-weight: 400; }
			.nav-logo {
				width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center;
				background: linear-gradient(145deg, #fbf8f1, #d9d3c4);
			}
			.nav-links { display: flex; align-items: center; gap: 1.6rem; font-size: 0.95rem; }
			.nav-links a:not(.nav-cta) { color: var(--text-muted); }
			.nav-links a:not(.nav-cta):hover { color: #fff; }
			.nav-cta {
				padding: 0.45rem 1rem; border-radius: 10px; background: var(--accent-primary); color: #000 !important;
				font-weight: 600; font-size: 0.9rem;
			}
			.nav-cta:hover { background: #fff; }

			/* ---------- Hero ---------- */
			.hero { display: grid; grid-template-columns: 1.25fr 1fr; gap: 3rem; align-items: center; padding: 4.5rem 0 3.5rem; }
			.store-pill {
				display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.35rem 0.9rem 0.35rem 0.4rem; border-radius: 999px;
				border: 1px solid var(--border-color); background: rgba(244, 240, 230, 0.05); color: var(--text-main); font-size: 0.88rem;
				margin-bottom: 1.5rem;
			}
			.store-pill:hover { border-color: rgba(244, 240, 230, 0.45); color: #fff; }
			.store-pill .tag {
				display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.12rem 0.6rem; border-radius: 999px;
				background: var(--accent-primary); color: #000; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
				white-space: nowrap; flex-shrink: 0;
			}
			.pulse { width: 6px; height: 6px; border-radius: 50%; background: #000; animation: pulse 1.8s ease-in-out infinite; }
			@keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.7); } }
			.hero h1 { font-size: clamp(2.8rem, 6vw, 4.4rem); line-height: 1.05; margin-bottom: 1rem; }
			.hero h1 .h1-sub {
				display: block; margin-top: 0.6rem; font-size: clamp(1.25rem, 2.6vw, 1.7rem); font-weight: 500; line-height: 1.3;
				-webkit-text-fill-color: rgba(255, 255, 255, 0.85); color: rgba(255, 255, 255, 0.85);
			}
			.lead { font-size: 1.1rem; max-width: 540px; margin-bottom: 2rem; }
			.cta {
				display: inline-flex; align-items: center; gap: 1rem; padding: 1rem 2rem 1rem 1.5rem; border-radius: 16px;
				background: var(--accent-primary); color: #000; font-weight: 700; font-size: 1.15rem; text-align: left;
				box-shadow: 0 10px 40px rgba(244, 240, 230, 0.22); transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
			}
			.cta:hover { color: #000; background: #fff; transform: translateY(-3px); box-shadow: 0 16px 50px rgba(244, 240, 230, 0.35); }
			.cta .os-icon { width: 28px; height: 28px; }
			.cta small { display: block; font-size: 0.8rem; font-weight: 500; opacity: 0.65; }
			[data-hero][hidden] { display: none; }
			.hero-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-top: 1.1rem; font-size: 0.93rem; }
			.hero-links a { color: var(--text-muted); text-decoration: underline; text-underline-offset: 3px; }
			.hero-links a:hover { color: #fff; }

			.glance { padding: 1.75rem; }
			.glance-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
			.app-icon {
				width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center; flex-shrink: 0;
				background: linear-gradient(145deg, #fbf8f1, #d9d3c4); box-shadow: 0 14px 40px rgba(244, 240, 230, 0.15);
			}
			.app-icon svg { width: 34px; height: 34px; }
			.glance-head strong { display: block; font-size: 1.2rem; color: #fff; }
			.glance-head span { font-size: 0.9rem; color: var(--text-muted); }
			.facts { display: grid; grid-template-columns: auto 1fr; gap: 0.55rem 1.25rem; margin: 0; font-size: 0.93rem; }
			.facts dt { color: var(--text-muted); }
			.facts dd { margin: 0; color: #fff; display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap; }
			.facts .os-icon { color: var(--accent-primary); }
			.glance-notes { margin-top: 1.25rem; padding-top: 1.1rem; border-top: 1px solid rgba(244, 240, 230, 0.1); }
			.glance-notes h2 { font-size: 0.95rem; margin-bottom: 0.4rem; color: #fff; }
			.glance-notes p { font-size: 0.9rem; margin: 0; line-height: 1.6; }

			/* ---------- Sections ---------- */
			.section { padding-top: 4.5rem; scroll-margin-top: 3.5rem; }
			.eyebrow { display: block; text-align: center; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-primary); margin-bottom: 0.6rem; }
			.section-title { font-size: clamp(1.6rem, 3.2vw, 2.1rem); text-align: center; margin-bottom: 0.6rem; }
			.section-sub { text-align: center; margin: 0 auto 2rem; max-width: 620px; }
			.card {
				background: rgba(255, 255, 255, 0.035); border: 1px solid rgba(244, 240, 230, 0.14); border-radius: 18px;
				transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s ease;
			}

			/* Tabs */
			.tabs {
				display: flex; gap: 0.35rem; width: fit-content; margin: 0 auto 1.5rem; padding: 0.35rem;
				border: 1px solid var(--border-color); border-radius: 14px; background: rgba(255, 255, 255, 0.03);
			}
			.tab {
				display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.55rem 1.4rem; border-radius: 10px; border: 0;
				background: transparent; color: var(--text-muted); font-family: inherit; font-size: 1rem; font-weight: 600; cursor: pointer;
				transition: background 0.2s, color 0.2s;
			}
			.tab .os-icon { width: 18px; height: 18px; }
			.tab:hover { color: #fff; }
			.tab[aria-selected='true'] { background: var(--accent-primary); color: #000; }

			/* File cards */
			.file-list { display: grid; gap: 0.85rem; }
			.file { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem 1.25rem; align-items: center; padding: 1.3rem 1.5rem; }
			.file:hover { border-color: rgba(244, 240, 230, 0.28); background: rgba(255, 255, 255, 0.05); }
			.file-os { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; background: rgba(244, 240, 230, 0.1); color: var(--accent-primary); }
			.file-os .os-icon { width: 26px; height: 26px; }
			.file-name { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; font-weight: 600; font-size: 1.05rem; color: #fff; margin: 0; }
			.badge { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.15rem 0.55rem; border-radius: 999px; background: rgba(244, 240, 230, 0.15); color: var(--accent-primary); }
			.file-sub { font-size: 0.9rem; color: var(--text-muted); margin: 0.2rem 0 0; }
			.file-sha { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; font-size: 0.76rem; color: rgba(255, 255, 255, 0.5); }
			.file-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; justify-content: flex-end; }
			.btn-dl, .btn-ghost {
				display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.7rem 1.2rem; border-radius: 12px; font-family: inherit;
				font-size: 0.95rem; font-weight: 600; cursor: pointer; white-space: nowrap; transition: background 0.2s, transform 0.2s, border-color 0.2s;
			}
			.btn-dl { background: var(--accent-primary); color: #000; border: 1px solid transparent; }
			.btn-dl:hover { background: #fff; color: #000; transform: translateY(-2px); }
			.btn-dl svg { width: 18px; height: 18px; }
			.btn-ghost { background: transparent; color: var(--accent-primary); border: 1px solid var(--border-color); }
			.btn-ghost:hover { border-color: rgba(244, 240, 230, 0.5); color: #fff; }
			.copy { padding: 0.2rem 0.6rem; border-radius: 7px; border: 1px solid var(--border-color); background: rgba(244, 240, 230, 0.06); color: var(--accent-primary); font-family: inherit; font-size: 0.75rem; cursor: pointer; }
			.copy:hover { background: rgba(244, 240, 230, 0.16); }
			.notice {
				display: flex; gap: 0.75rem; align-items: flex-start; margin-top: 1rem; padding: 1rem 1.2rem; border-radius: 14px;
				border: 1px solid rgba(244, 240, 230, 0.2); background: rgba(244, 240, 230, 0.05); font-size: 0.93rem; color: var(--text-muted);
			}
			.notice svg { flex-shrink: 0; width: 20px; height: 20px; margin-top: 0.2rem; color: var(--accent-primary); }
			.notice strong { color: #fff; }
			.kbd { display: inline-block; padding: 0 0.4rem; border-radius: 6px; border: 1px solid rgba(244, 240, 230, 0.3); background: rgba(244, 240, 230, 0.08); color: #fff; font-size: 0.85em; font-weight: 600; white-space: nowrap; }

			/* Features */
			.features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
			.feature { padding: 1.5rem; }
			.feature:hover { border-color: rgba(244, 240, 230, 0.3); background: rgba(255, 255, 255, 0.06); transform: translateY(-3px); }
			.feature-icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: rgba(244, 240, 230, 0.1); color: var(--accent-primary); margin-bottom: 1rem; }
			.feature-icon svg { width: 22px; height: 22px; }
			.feature h3 { font-size: 1.08rem; margin-bottom: 0.4rem; }
			.feature p { font-size: 0.94rem; margin: 0; line-height: 1.6; }

			/* Install overview */
			.install-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
			.install { padding: 1.5rem; display: flex; flex-direction: column; }
			.install-head { display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.9rem; }
			.install-head .os-icon { width: 22px; height: 22px; color: var(--accent-primary); }
			.install h3 { font-size: 1.1rem; margin: 0; }
			.install ol { margin: 0 0 1.2rem 1.1rem; display: grid; gap: 0.45rem; font-size: 0.93rem; color: var(--text-muted); }
			.install code { font-size: 0.82rem; color: #e9e5da; word-break: break-word; }
			.install .btn-ghost { margin-top: auto; align-self: flex-start; padding: 0.55rem 1rem; font-size: 0.9rem; }

			/* Store */
			.store {
				display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 2rem; padding: 2.25rem 2.5rem;
				background: linear-gradient(120deg, rgba(244, 240, 230, 0.1), rgba(244, 240, 230, 0.02)); border-color: rgba(244, 240, 230, 0.25);
			}
			.store-icon { width: 72px; height: 72px; border-radius: 18px; display: grid; place-items: center; background: rgba(244, 240, 230, 0.12); color: var(--accent-primary); }
			.store-icon svg { width: 38px; height: 38px; }
			.store h2 { font-size: 1.55rem; margin-bottom: 0.4rem; }
			.store p { margin: 0; }
			.store-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.8rem 1.4rem; border-radius: 12px; border: 1px dashed rgba(244, 240, 230, 0.45); color: var(--accent-primary); font-weight: 600; white-space: nowrap; }

			/* FAQ */
			.faq { max-width: 820px; margin: 0 auto; display: grid; gap: 0.7rem; }
			.faq details { padding: 0; }
			.faq summary {
				list-style: none; cursor: pointer; padding: 1.1rem 1.4rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
				font-weight: 600; color: #fff; border-radius: 18px;
			}
			.faq summary::-webkit-details-marker { display: none; }
			.faq summary::after { content: '+'; font-size: 1.4rem; line-height: 1; color: var(--accent-primary); transition: transform 0.2s; }
			.faq details[open] summary::after { transform: rotate(45deg); }
			.faq details p { padding: 0 1.4rem 1.2rem; margin: 0; font-size: 0.95rem; }
			.faq details:hover { border-color: rgba(244, 240, 230, 0.28); }

			/* Footer */
			.foot { margin-top: 5rem; padding-top: 2rem; border-top: 1px solid rgba(244, 240, 230, 0.1); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; font-size: 0.9rem; color: var(--text-muted); }
			.foot nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }
			.foot a { color: var(--text-muted); }
			.foot a:hover { color: #fff; }
			.unavailable { padding: 1.5rem; }
			.unavailable p { margin: 0; }

			/* ---------- Mobile toast (TorrentX for Android) ---------- */
			.toast {
				position: fixed; left: 50%; bottom: 16px; z-index: 30; width: min(440px, calc(100vw - 24px));
				transform: translate(-50%, calc(100% + 40px)); opacity: 0; transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s;
				display: grid; grid-template-columns: auto 1fr auto; gap: 0.85rem; align-items: start; padding: 1rem 1rem 1rem 1.1rem;
				border-radius: 18px; border: 1px solid rgba(244, 240, 230, 0.28); background: rgba(16, 16, 15, 0.96);
				backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
			}
			.toast.show { transform: translate(-50%, 0); opacity: 1; }
			.toast[hidden] { display: none; }
			.toast-icon { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; background: linear-gradient(145deg, #fbf8f1, #d9d3c4); color: #000; }
			.toast-icon svg { width: 22px; height: 22px; }
			.toast strong { display: block; color: #fff; font-size: 0.98rem; margin-bottom: 0.15rem; }
			.toast p { margin: 0 0 0.7rem; font-size: 0.86rem; line-height: 1.5; }
			.toast-btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 0.95rem; border-radius: 10px; background: var(--accent-primary); color: #000; font-weight: 600; font-size: 0.88rem; }
			.toast-btn:hover { background: #fff; color: #000; }
			.toast-close { width: 30px; height: 30px; border-radius: 8px; border: 0; background: transparent; color: var(--text-muted); font-size: 1.3rem; line-height: 1; cursor: pointer; }
			.toast-close:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }

			/* ---------- Install guide dialog (InstallGuides component) ---------- */
			dialog.guide {
				width: min(640px, calc(100vw - 2rem)); max-height: calc(100vh - 2rem); margin: auto; padding: 0;
				border: 1px solid rgba(244, 240, 230, 0.25); border-radius: 20px; background: #0d0d0c; color: var(--text-main);
				box-shadow: 0 30px 100px rgba(0, 0, 0, 0.7);
			}
			dialog.guide::backdrop { background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px); }
			dialog.guide[open] { animation: pop 0.25s cubic-bezier(0.2, 0.7, 0.2, 1); }
			@keyframes pop { from { opacity: 0; transform: translateY(10px) scale(0.98); } to { opacity: 1; transform: none; } }
			.dialog-head { position: sticky; top: 0; display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1.5rem 1.75rem 1rem; background: #0d0d0c; border-bottom: 1px solid rgba(244, 240, 230, 0.1); }
			.dialog-status { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--accent-primary); margin-bottom: 0.25rem; }
			.dialog-status[hidden] { display: none; }
			.dialog-head h2 { font-size: 1.4rem; margin: 0; }
			.dialog-close { flex-shrink: 0; width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--border-color); background: transparent; color: #fff; font-size: 1.3rem; line-height: 1; cursor: pointer; }
			.dialog-close:hover { background: rgba(255, 255, 255, 0.08); }
			.dialog-body { padding: 1.25rem 1.75rem 1.75rem; }
			.dialog-body p { font-size: 0.95rem; margin-bottom: 0.9rem; }
			.dialog-foot { margin-top: 1.25rem; font-size: 0.88rem; color: var(--text-muted); }
			.steps { list-style: none; counter-reset: step; margin: 1rem 0 0; display: grid; gap: 1rem; }
			.steps > li { counter-increment: step; position: relative; min-width: 0; padding-left: 2.6rem; font-size: 0.95rem; color: var(--text-muted); }
			.steps > li::before { content: counter(step); position: absolute; left: 0; top: 0; width: 1.75rem; height: 1.75rem; border-radius: 50%; display: grid; place-items: center; background: rgba(244, 240, 230, 0.12); color: var(--accent-primary); font-size: 0.85rem; font-weight: 700; }
			.steps strong { color: #fff; }
			.steps ul { margin: 0.4rem 0 0 1.1rem; display: grid; gap: 0.25rem; }
			.cmd { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; padding: 0.55rem 0.6rem 0.55rem 0.9rem; border: 1px solid rgba(244, 240, 230, 0.15); border-radius: 10px; background: #000; }
			.cmd code { flex: 1; min-width: 0; overflow-x: auto; white-space: pre; font-size: 0.82rem; color: #e9e5da; scrollbar-width: thin; }
			.cmd .copy { flex-shrink: 0; }

			/* ---------- Motion & responsive ---------- */
			.rise { animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
			.rise-2 { animation-delay: 0.08s; }
			@keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
			@media (prefers-reduced-motion: reduce) {
				html { scroll-behavior: auto; }
				.rise, .pulse, dialog.guide[open] { animation: none; }
				.cta, .feature, .btn-dl, .toast { transition: none; }
			}
			@media (max-width: 960px) {
				.hero { grid-template-columns: 1fr; gap: 2rem; padding-top: 3rem; }
				.features, .install-grid { grid-template-columns: repeat(2, 1fr); }
				.store { grid-template-columns: 1fr; text-align: center; justify-items: center; gap: 1.25rem; }
			}
			@media (max-width: 720px) {
				.nav-links a:not(.nav-cta) { display: none; }
				.file { grid-template-columns: auto 1fr; }
				.file-actions { grid-column: 1 / -1; justify-content: stretch; }
				.file-actions > * { flex: 1; justify-content: center; }
				.file-os { width: 40px; height: 40px; border-radius: 11px; align-self: start; }
				.file-os .os-icon { width: 20px; height: 20px; }
			}
			@media (max-width: 560px) {
				.features, .install-grid { grid-template-columns: 1fr; }
				.cta { width: 100%; }
				.store { padding: 2rem 1.5rem; }
				.nav-brand .crumb { display: none; }
				.dialog-head, .dialog-body { padding-left: 1.25rem; padding-right: 1.25rem; }
			}
		</style>
	</head>
