		<InstallGuides />

		<script>
			// ---------- Install guide dialog ----------
			const dialog = document.getElementById('guide') as HTMLDialogElement | null;
			const titleEl = document.getElementById('guide-title');
			const bodyEl = document.getElementById('guide-body');
			const statusEl = document.getElementById('guide-status');

			function openGuide(id: string, started: boolean) {
				const tpl = document.getElementById(`guide-${id}`) as HTMLTemplateElement | null;
				if (!dialog || !tpl || !bodyEl || !titleEl || !statusEl) return;
				titleEl.textContent = tpl.dataset.title ?? 'How to install';
				bodyEl.replaceChildren(tpl.content.cloneNode(true));
				statusEl.hidden = !started;
				if (!dialog.open) dialog.showModal();
				dialog.scrollTo(0, 0);
			}

			document.getElementById('guide-close')?.addEventListener('click', () => dialog?.close());
			dialog?.addEventListener('click', (e) => {
				if (e.target === dialog) dialog.close(); // click on backdrop
			});

			// ---------- Tabs ----------
			const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"][data-tab]'));
			function selectTab(name: string, focus = false) {
				for (const tab of tabs) {
					const selected = tab.dataset.tab === name;
					tab.setAttribute('aria-selected', String(selected));
					tab.tabIndex = selected ? 0 : -1;
					const panel = document.getElementById(tab.getAttribute('aria-controls')!);
					if (panel) panel.hidden = !selected;
					if (selected && focus) tab.focus();
				}
			}
			tabs.forEach((tab, i) => {
				tab.addEventListener('click', () => selectTab(tab.dataset.tab!));
				tab.addEventListener('keydown', (e) => {
					if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
					const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
					selectTab(next.dataset.tab!, true);
				});
			});

			// ---------- Clicks: downloads, guides, copy, tab links ----------
			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;

				// Download links: let the download start, then show the matching instructions.
				const dl = target.closest<HTMLAnchorElement>('a[data-guide]');
				if (dl) {
					setTimeout(() => openGuide(dl.dataset.guide!, true), 150);
					return;
				}

				const info = target.closest<HTMLElement>('[data-guide-open]');
				if (info) {
					openGuide(info.dataset.guideOpen!, false);
					return;
				}

				const copyBtn = target.closest<HTMLButtonElement>('button[data-copy]');
				if (copyBtn) {
					const original = copyBtn.textContent;
					const done = (label: string) => {
						copyBtn.textContent = label;
						setTimeout(() => (copyBtn.textContent = original), 1600);
					};
					navigator.clipboard?.writeText(copyBtn.dataset.copy ?? '').then(() => done('Copied'), () => done('Copy failed'));
					return;
				}

				const tabLink = target.closest<HTMLElement>('[data-open-tab]');
				if (tabLink) selectTab(tabLink.dataset.openTab!);
			});

			// ---------- Detect the visitor's OS ----------
			const ua = navigator.userAgent;
			const isAndroid = /Android/i.test(ua);
			const isIOS = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
			const isMobile = isAndroid || isIOS || /Mobi/i.test(ua);
			const isLinux = /Linux|X11|CrOS/i.test(ua) && !isAndroid;

			let hero = 'windows';
			if (isLinux) {
				if (/Ubuntu|Debian|Mint|Pop!?_?OS/i.test(ua)) hero = 'deb';
				else if (/Fedora|SUSE|Red Hat/i.test(ua)) hero = 'rpm';
				else hero = 'linux';
			}
			if (isLinux || location.hash === '#linux') selectTab('linux');
			const heroEls = document.querySelectorAll<HTMLElement>('[data-hero]');
			if (Array.from(heroEls).some((el) => el.dataset.hero === hero)) {
				heroEls.forEach((el) => (el.hidden = el.dataset.hero !== hero));
			}

			// ---------- Mobile: suggest TorrentX for Android ----------
			const toast = document.getElementById('android-toast');
			const DISMISS_KEY = 'txd-android-toast-dismissed';
			const dismissedAt = Number(localStorage.getItem(DISMISS_KEY) || 0);
			const recentlyDismissed = Date.now() - dismissedAt < 7 * 24 * 60 * 60 * 1000;

			if (toast && isMobile && !recentlyDismissed) {
				if (isIOS) {
					// TorrentX is Android-only: point iPhone/iPad visitors to the app page instead of Google Play.
					const link = document.getElementById('toast-link') as HTMLAnchorElement | null;
					const text = document.getElementById('toast-text');
					if (link) {
						link.href = '/apps/torrentx';
						link.textContent = 'Learn about TorrentX';
						link.removeAttribute('target');
					}
					if (text) text.textContent = 'TorrentXDesk is for Windows & Linux computers. Got an Android device? Try TorrentX.';
				}
				toast.hidden = false;
				setTimeout(() => toast.classList.add('show'), 1200);
				document.getElementById('toast-close')?.addEventListener('click', () => {
					toast.classList.remove('show');
					localStorage.setItem(DISMISS_KEY, String(Date.now()));
					setTimeout(() => (toast.hidden = true), 450);
				});
			}
		</script>
	</body>
</html>
